!data/reference/.gitkeep
!data/processed/.gitkeep
!data/raw/.gitkeep
!outputs/.gitkeep

# Dados derivados de operações privadas
data/processed/operacoes_*
data/processed/*.npy
!data/processed/cnaes_embeddings.npy

# Saídas e entregas locais
outputs/*
