# Ambiente virtual e caches do Python
.venv/
env/
venv/
__pycache__/
*.py[cod]
*$py.class
*.log

# Caches de modelos e transformers
.cache/
hf_cache/

# Dados privados, bases locais e arquivos volumosos (>100MB)
data/private/
data/raw/IMP_*.csv
